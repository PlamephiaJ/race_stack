<?xml version="1.0"?>
<package format="3">
  <name>map_editor</name>
  <version>0.1.0</version>
  <description>Standalone Qt map drawing and offline Global Planner preview.</description>
  <maintainer email="nicolas.baumann@pbl.ee.ethz.ch">ForzaETH</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- PySide6 is installed with pip on ROS Humble / Ubuntu 22.04; see README. -->
  <exec_depend>global_planner</exec_depend>
  <exec_depend>stack_master</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
