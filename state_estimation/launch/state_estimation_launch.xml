<?xml version="1.0"?>
<launch>
    <arg name="loc_algorithm" default="synpf"
        description="synpf (default), pf or cartographer (alias: slam); particle-filter mapping uses slam_toolbox" />
    <arg name="pf_config" default="$(find-pkg-share stack_master)/config/particle_filter.yaml" />
    <arg name="synpf_config" default="$(find-pkg-share stack_master)/config/synpf.yaml" />
    <arg name="slam_toolbox_config" default="$(find-pkg-share stack_master)/config/slam_toolbox.yaml" />
    <arg name="mapping_bool" default="True" />
    <arg name="map_name" default="hangar" />
    <arg name="skip_early_fusion" default="False" />
    <arg name="use_sim_time" default="False" />
    <arg name="use_vio" default="$(env USE_VIO false)"
        description="Run Basalt VIO (set via USE_VIO in .env)" />
    <arg name="viz_flow" default="False" />
    <arg name="enable_initialpose" default="True" />
    <arg name="reference_trajectory_id" default="-1"
        description="Frozen map trajectory for initial poses; -1 selects the lowest frozen ID" />
    <arg name="racecar_version" default="$(env RACECAR_VERSION)" />
    <arg name="slam_config_path"
        default="$(find-pkg-share stack_master)/config/$(var racecar_version)/slam" />

    <include file="$(find-pkg-share state_estimation)/launch/check_backend_launch.py">
        <arg name="loc_algorithm" value="$(var loc_algorithm)" />
        <arg name="mapping_bool" value="$(var mapping_bool)" />
        <arg name="map_file" value="$(find-pkg-share stack_master)/maps/$(var map_name)/$(var map_name)" />
    </include>

    <group>
        <set_parameter name="use_sim_time" value="$(var use_sim_time)" />

        <!-- VESC IMU rotated into base_link, synchronously (imu_transformer reorders messages at
        startup,
             which cartographer refuses). Input of the EKF, so it lives here and not in the driver bringup. -->
        <node pkg="state_estimation" exec="imu_to_base_node" name="imu_to_base">
            <param name="input_topic" value="/sensors/imu/raw" />
            <param name="output_topic" value="/imu" />
            <param name="target_frame" value="base_link" />
            <param from="$(find-pkg-share stack_master)/config/$(var racecar_version)/imu.yaml" />
        </node>

        <!-- EKF IMU + Odom Fusion -->
        <group unless="$(var skip_early_fusion)">
            <include file="$(find-pkg-share state_estimation)/launch/ekf_node_launch.py">
                <arg name="custom_ekf" value="false" />
                <arg name="model_type" value="point_mass_model" />
            </include>
        </group>

        <!--  LOCALIZATION -->
        <let name="map_path" value="$(find-pkg-share stack_master)/maps/$(var map_name)" />

        <!-- IF SLAM LOC ONLY -->
        <group unless="$(var mapping_bool)">
            <group if="$(eval &quot;'$(var loc_algorithm)' in ['cartographer', 'slam']&quot;)">
                <!-- start cartographer SLAM LOCALIZATION -->
                <node name="cartographer_node" pkg="cartographer_ros" exec="cartographer_node"
                    args="
                    -configuration_directory $(var slam_config_path)
                    -configuration_basename f110_2d_loc.lua
                    -load_state_filename $(var map_path)/$(var map_name).pbstream
                    --minloglevel 2">
                    <remap from="odom" to="state_estimation/odom" />
                </node>

                <!-- RViz /initialpose resets the live localization trajectory, preserving the frozen map. -->
                <node if="$(var enable_initialpose)" pkg="state_estimation" exec="cartographer_initialpose"
                    name="cartographer_initialpose" output="screen">
                    <param name="configuration_directory" value="$(var slam_config_path)" />
                    <param name="configuration_basename" value="f110_2d_loc.lua" />
                    <param name="reference_trajectory_id" value="$(var reference_trajectory_id)" />
                    <param name="map_frame" value="map" />
                </node>

                <!-- Keep the live SLAM grid separate from the saved map on /map. -->
                <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
                    exec="cartographer_occupancy_grid_node" args="-resolution 0.05">
                    <remap from="map" to="/map_raw" />
                </node>

            </group>

            <node if="$(eval &quot;'$(var loc_algorithm)' == 'pf'&quot;)"
                pkg="state_estimation" exec="particle_filter" name="particle_filter" output="screen">
                <param from="$(var pf_config)" />
            </node>

            <node if="$(eval &quot;'$(var loc_algorithm)' == 'synpf'&quot;)"
                pkg="state_estimation" exec="synpf" name="synpf" output="screen">
                <param from="$(var synpf_config)" />
            </node>

            <!-- Launch map server with regular map name reads from OG MAP-->
            <node pkg="nav2_map_server" name="map_server" exec="map_server" output="screen">
                <param name="yaml_filename" value="$(var map_path)/$(var map_name).yaml" />
            </node>
            <node pkg="nav2_lifecycle_manager" name="lifecycle_manager" exec="lifecycle_manager"
                output="screen">
                <param name="autostart" value="True" />
                <param name="node_names" value="[map_server]" />
            </node>

        </group>

        <!-- ELIF SLAM MAPPING -->
        <group if="$(var mapping_bool)">
            <group if="$(eval &quot;'$(var loc_algorithm)' in ['cartographer', 'slam']&quot;)">
                <!-- start cartographer SLAM MAPPING -->
                <node name="cartographer_node" pkg="cartographer_ros" exec="cartographer_node"
                    args="
                    -configuration_directory $(var slam_config_path)
                    -configuration_basename f110_2d.lua
                    --minloglevel 2">
                    <remap from="odom" to="state_estimation/odom" />
                </node>

                <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
                    exec="cartographer_occupancy_grid_node" args="-resolution 0.05">
                </node>
            </group>
            <group if="$(eval &quot;'$(var loc_algorithm)' in ['pf', 'synpf']&quot;)">
                <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
                    <arg name="slam_params_file" value="$(var slam_toolbox_config)" />
                    <arg name="use_sim_time" value="$(var use_sim_time)" />
                </include>
            </group>
        </group>

        <include if="$(var use_vio)"
            file="$(find-pkg-share state_estimation)/launch/vio_composed.launch.py">
            <arg name="racecar_version" value="$(var racecar_version)" />
            <arg name="viz_flow" value="$(var viz_flow)" />
        </include>

        <!-- Carstate Node: /car_state/pose from TF -->
        <node name="carstate_node" pkg="state_estimation" exec="carstate_node" output="screen" />
    </group>

</launch>
