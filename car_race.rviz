# Real-car RViz2 view, based on stack_master/viz/head_to_head.rviz.
# On the operator computer, use the same ROS_DOMAIN_ID as the car.
# Run from the repository root:
#   rviz2 -d car_race.rviz --ros-args -p use_sim_time:=false
# The car publishes the map, TF, scan and pose; no local map file is required.
# Maps: saved /map (default), raw /map_raw, live filtered /map_filtered.
# Toggle each map independently in the Maps group.
# Localized Car Pose is the orange arrow; EKF Odometry is optional.
Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Maps1
    - /Real Car1
    - /Planner1
    Splitter Ratio: 0.5
  Tree Height: 919
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: false
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: false
  - Class: rviz_default_plugins/TF
    Enabled: false
    Frame Timeout: 15
    Frames:
      All Enabled: true
      base_link:
        Value: true
      camera_link:
        Value: true
      car_state/base_link:
        Value: true
      car_state/laser:
        Value: true
      imu:
        Value: true
      laser:
        Value: true
      map:
        Value: true
      odom:
        Value: true
    Marker Scale: 1
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree:
      map:
        odom:
          base_link:
            camera_link: {}
            car_state/base_link: {}
            imu: {}
            laser:
              car_state/laser: {}
    Update Interval: 0
    Value: false
  - Class: rviz_common/Group
    Name: Maps
    Enabled: true
    Displays:
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Saved Map (edited)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: SLAM Map (raw)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_raw
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /map_raw_updates
      Use Timestamp: false
      Value: false
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: SLAM Map (filtered)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_filtered
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /map_filtered_updates
      Use Timestamp: false
      Value: false
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: State
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /state_marker
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Centerline
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /centerline_waypoints/markers
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Global Waypoints
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /global_waypoints/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Lattice Viz
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lattice_viz
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Track Bounds
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /trackbounds/markers
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Overtaking Waypoints
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /global_waypoints/overtaking/markers
      Value: false
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_default_plugins/MarkerArray
        Enabled: true
        Name: Speed Sectors
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /sector_markers
        Value: true
      - Class: rviz_default_plugins/MarkerArray
        Enabled: true
        Name: OT Sectors
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /ot_sector_markers
        Value: true
      Enabled: false
      Name: Sector Markers
    Enabled: true
    Name: Map Markers
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/Pose
      Name: Localized Car Pose
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /car_state/pose
        Filter size: 10
      Shape: Arrow
      Color: 255; 70; 30
      Alpha: 1
      Shaft Length: 0.45
      Shaft Radius: 0.06
      Head Length: 0.2
      Head Radius: 0.14
      Axes Length: 0.5
      Axes Radius: 0.03
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4.604157447814941
        Min Value: -0.8566509485244751
        Value: true
      Axis: X
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 0; 220; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Ego Scan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Angle Tolerance: 0.10000000149011612
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.30000001192092896
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: false
      Enabled: false
      Keep: 1
      Name: EKF Odometry (optional)
      Position Tolerance: 0.10000000149011612
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.10000000149011612
        Color: 255; 25; 0
        Head Length: 0.30000001192092896
        Head Radius: 0.10000000149011612
        Shaft Length: 1
        Shaft Radius: 0.05000000074505806
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /state_estimation/odom
      Value: false
    Enabled: true
    Name: Real Car
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_default_plugins/MarkerArray
        Enabled: false
        Name: Breakpoints
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: System Default
          History Policy: Keep Last
          Reliability Policy: System Default
          Value: /perception/breakpoints_markers
        Value: false
      - Class: rviz_default_plugins/Marker
        Enabled: true
        Name: Detect Bound
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /perception/detect_bound
        Value: true
      - Class: rviz_default_plugins/MarkerArray
        Enabled: true
        Name: Obstacle Markers New
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /perception/obstacles_markers_new
        Value: true
      Enabled: true
      Name: Detection
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_default_plugins/MarkerArray
        Enabled: true
        Name: Static/Dynamic Markers
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /perception/static_dynamic_marker_pub
        Value: true
      Enabled: true
      Name: Tracking
    Enabled: true
    Name: Perception
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Avoidance
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planner/avoidance/markers
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Considered OBS
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planner/avoidance/considered_OBS
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Local Control Waypoints
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /local_waypoints/markers
      Value: true
    Enabled: true
    Name: Planner
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Value: TopDownOrtho (rviz_default_plugins)
      Target Frame: <Fixed Frame>
      Angle: 0
      Scale: 24
      X: 3.6
      Y: 4.2
      Near Clip Distance: 0.01
      Invert Z Axis: false
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1440
  X: 50
  Y: 50
